{
  "name": "cortexpe/commando",
  "description": "A Command Framework virion for PocketMine-MP ",
  "type": "library",
  "license": "LGPL-3.0-only",
  "require": {
    "muqsit/simple-packet-handler": "dev-pm5"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/elopedmc/simplepackethandler"
    }
  ],
  "extra": {
    "virion": {
      "spec": "3.0",
      "namespace-root": "CortexPE\\Commando"
    }
  },
  "autoload": {
    "psr-4": {
      "CortexPE\\Commando\\": [
        "src/CortexPE/Commando/"
      ]
    }
  }
}
